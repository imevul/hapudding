# Copy to .env and uncomment what you need. Compose reads .env when present.
# All values here are commented so a blind copy is opt-in.

# HAP_LISTEN=:8096
# HAP_STATUS_LISTEN=127.0.0.1:9100
# HAP_CONFIG=/config/hap.yaml

# HAP_STORE=sqlite
# HAP_SQLITE_PATH=/data/affinity.db

# HAP_STORE=postgres
# HAP_DATABASE_URL=postgres://hap:hap@postgres:5432/hap?sslmode=disable
# POSTGRES_USER=hap
# POSTGRES_PASSWORD=hap
# POSTGRES_DB=hap

# Affinity
# HAP_AFFINITY_POLICY=force_reauth
# HAP_GRAYLIST_POLICY=fail_closed
# HAP_NEW_CLIENTS_REQUIRE=healthy

# Per-backend extra hop headers (never Authorization / X-Emby-*).
# Name is the backend name, uppercased, dashes to underscores.
# HAP_BACKEND_SERVER_A_HEADER_X_SITE_TOKEN=
# HAP_BACKEND_SERVER_B_HEADER_X_SITE_TOKEN=
